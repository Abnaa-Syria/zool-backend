{
  "info": {
    "name": "ZoolGo Stage 1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api/v1" },
    { "key": "accessToken", "value": "" },
    { "key": "phone", "value": "+249900000001" },
    { "key": "devOtp", "value": "" },
    { "key": "challengeId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Ready",
      "request": { "method": "GET", "url": "{{baseUrl}}/ready" }
    },
    {
      "name": "OTP Request",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json().data;",
              "if (data.devOtp) pm.collectionVariables.set('devOtp', data.devOtp);",
              "pm.collectionVariables.set('challengeId', data.challengeId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"{{phone}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/otp/request"
      }
    },
    {
      "name": "OTP Verify",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json().data;",
              "pm.collectionVariables.set('accessToken', data.accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"code\": \"{{devOtp}}\",\n  \"challengeId\": \"{{challengeId}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/otp/verify"
      }
    },
    {
      "name": "Me",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/auth/me"
      }
    }
  ]
}
