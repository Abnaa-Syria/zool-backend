              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/phone/otp/verify",
            "description": "Consumes the OTP and updates the authenticated admin's primary phone. Does not issue a new session. Mutates identity — skip unless testing this flow."
          }
        },
