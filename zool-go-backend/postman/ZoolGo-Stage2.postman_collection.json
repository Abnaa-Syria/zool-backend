                  "const j = pm.response.json();",
                  "if (j.data && j.data.devOtp !== undefined) pm.collectionVariables.set('phoneChangeDevOtp', j.data.devOtp);",
                  "if (j.data && j.data.challengeId !== undefined) pm.collectionVariables.set('challengeId', j.data.challengeId);"
