enum TripSeatStatus {
  FREE
  HELD
  SOLD
}

model Trip {
  id           String           @id @default(cuid())
  companyId    String           @map("company_id")
  origin       String           @db.VarChar(120)
  destination  String           @db.VarChar(120)
  departureAt  DateTime         @map("departure_at")
  basePrice    Int              @map("base_price")
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at")

  company      TransportCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  seats        TripSeat[]
  bookings     Booking[]

  @@index([companyId, departureAt])
  @@index([isActive, departureAt])
  @@map("trips")
}

model TripSeat {
  id        String         @id @default(cuid())
  tripId    String         @map("trip_id")
  seatLabel String         @map("seat_label") @db.VarChar(32)
  sortOrder Int            @default(0) @map("sort_order")
  status    TripSeatStatus @default(FREE)

  trip      Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  hold      SeatHold?
  tickets   Ticket[]

  @@unique([tripId, seatLabel])
  @@index([tripId, status])
  @@index([tripId, sortOrder])
  @@map("trip_seats")
}

model SeatHold {
  id         String         @id @default(cuid())
  tripSeatId String         @unique @map("trip_seat_id")
  officeId   String         @map("office_id")
  employeeId String         @map("employee_id")
  expiresAt  DateTime       @map("expires_at")
  createdAt  DateTime       @default(now()) @map("created_at")

  tripSeat   TripSeat       @relation(fields: [tripSeatId], references: [id], onDelete: Cascade)
  office     BrokerOffice   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  employee   BrokerEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([officeId, expiresAt])
  @@index([employeeId])
  @@index([expiresAt])
  @@map("seat_holds")
}
