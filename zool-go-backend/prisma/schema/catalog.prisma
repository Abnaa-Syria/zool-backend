enum TripSeatStatus {
  FREE
  HELD
  SOLD
}

model Trip {
  id                   String       @id @default(cuid())
  companyId            String       @map("company_id")
  /// Display names (kept for legacy rows; new trips fill them from the stations' cities)
  origin               String       @db.VarChar(120)
  destination          String       @db.VarChar(120)
  departureAt          DateTime     @map("departure_at")
  basePrice            Int          @map("base_price")
  isActive             Boolean      @default(true) @map("is_active")
  createdAt            DateTime     @default(now()) @map("created_at")
  /// Human trip number, e.g. EDT-4821
  tripNumber           String?      @unique @map("trip_number") @db.VarChar(32)
  routeId              String?      @map("route_id")
  originStationId      String?      @map("origin_station_id")
  destinationStationId String?      @map("destination_station_id")
  arrivalAt            DateTime?    @map("arrival_at")
  vehicleId            String?      @map("vehicle_id")
  driverId             String?      @map("driver_id")
  serviceClass         ServiceClass @default(STANDARD) @map("service_class")
  status               TripStatus   @default(SCHEDULED)
  startedAt            DateTime?    @map("started_at")
  completedAt          DateTime?    @map("completed_at")
  cancelledAt          DateTime?    @map("cancelled_at")
  updatedAt            DateTime     @default(now()) @updatedAt @map("updated_at")

  company            TransportCompany  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  route              Route?            @relation(fields: [routeId], references: [id], onDelete: SetNull)
  originStation      Station?          @relation("TripOriginStation", fields: [originStationId], references: [id], onDelete: Restrict)
  destinationStation Station?          @relation("TripDestinationStation", fields: [destinationStationId], references: [id], onDelete: Restrict)
  vehicle            Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver             Driver?           @relation(fields: [driverId], references: [id], onDelete: SetNull)
  seats              TripSeat[]
  bookings           Booking[]
  stops              TripStop[]
  boardingScans      BoardingScan[]
  cashCollections    CashCollection[]
  positions          VehiclePosition[]

  @@index([companyId, departureAt])
  @@index([isActive, departureAt])
  @@index([originStationId, destinationStationId, departureAt])
  @@index([driverId, departureAt])
  @@index([status, departureAt])
  @@map("trips")
}

model TripSeat {
  id           String         @id @default(cuid())
  tripId       String         @map("trip_id")
  seatLabel    String         @map("seat_label") @db.VarChar(32)
  sortOrder    Int            @default(0) @map("sort_order")
  status       TripSeatStatus @default(FREE)
  /// Grid position from the vehicle layout (null on legacy trips)
  layoutRow    Int?           @map("layout_row")
  layoutColumn Int?           @map("layout_column")
  isWomenOnly  Boolean        @default(false) @map("is_women_only")

  trip    Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  hold    SeatHold?
  tickets Ticket[]

  @@unique([tripId, seatLabel])
  @@index([tripId, status])
  @@index([tripId, sortOrder])
  @@map("trip_seats")
}

model SeatHold {
  id         String   @id @default(cuid())
  tripSeatId String   @unique @map("trip_seat_id")
  /// Holder is a broker employee (office + employee) or a customer
  officeId   String?  @map("office_id")
  employeeId String?  @map("employee_id")
  customerId String?  @map("customer_id")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  tripSeat TripSeat        @relation(fields: [tripSeatId], references: [id], onDelete: Cascade)
  office   BrokerOffice?   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  employee BrokerEmployee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  customer Customer?       @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([officeId, expiresAt])
  @@index([employeeId])
  @@index([customerId])
  @@index([expiresAt])
  @@map("seat_holds")
}
