enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum TicketStatus {
  CONFIRMED
  CANCELLED
}

enum TicketDispatchChannel {
  DOWNLOAD
  WHATSAPP
  SMS
}

enum TicketDispatchStatus {
  READY
  RECORDED
}

model Booking {
  id               String        @id @default(cuid())
  officeId         String        @map("office_id")
  employeeId       String        @map("employee_id")
  tripId           String        @map("trip_id")
  status           BookingStatus @default(CONFIRMED)
  totalAmount      Int           @map("total_amount")
  commissionAmount Int           @map("commission_amount")
  confirmedAt      DateTime      @map("confirmed_at")
  cancelledAt      DateTime?     @map("cancelled_at")
  createdAt        DateTime      @default(now()) @map("created_at")

  office           BrokerOffice  @relation(fields: [officeId], references: [id], onDelete: Cascade)
  employee         BrokerEmployee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  trip             Trip          @relation(fields: [tripId], references: [id], onDelete: Restrict)
  passengers       BookingPassenger[]
  tickets          Ticket[]
  commissionAccrual CommissionAccrual?
  dispatchAttempts TicketDispatchAttempt[]

  @@index([officeId, createdAt])
  @@index([employeeId, createdAt])
  @@index([tripId, status])
  @@index([status, confirmedAt])
  @@map("bookings")
}

/// Record of a ticket dispatch attempt (download / future WhatsApp-SMS provider).
model TicketDispatchAttempt {
  id          String                @id @default(cuid())
  bookingId   String                @map("booking_id")
  employeeId  String                @map("employee_id")
  channel     TicketDispatchChannel
  status      TicketDispatchStatus
  /// Snapshot of TicketDocument JSON at dispatch time
  payloadJson Json                  @map("payload_json")
  createdAt   DateTime              @default(now()) @map("created_at")

  booking     Booking               @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  employee    BrokerEmployee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([bookingId, createdAt])
  @@index([employeeId, createdAt])
  @@map("ticket_dispatch_attempts")
}

model BookingPassenger {
  id        String   @id @default(cuid())
  bookingId String   @map("booking_id")
  fullName  String   @map("full_name") @db.VarChar(160)
  phone     String   @db.VarChar(32)
  idNumber  String?  @map("id_number") @db.VarChar(64)

  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tickets   Ticket[]

  @@index([bookingId])
  @@map("booking_passengers")
}

model Ticket {
  id           String       @id @default(cuid())
  bookingId    String       @map("booking_id")
  tripSeatId   String?      @map("trip_seat_id")
  passengerId  String       @map("passenger_id")
  ticketNumber String       @unique @map("ticket_number") @db.VarChar(64)
  status       TicketStatus @default(CONFIRMED)

  booking      Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tripSeat     TripSeat?        @relation(fields: [tripSeatId], references: [id], onDelete: SetNull)
  passenger    BookingPassenger @relation(fields: [passengerId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([tripSeatId])
  @@index([passengerId])
  @@map("tickets")
}
