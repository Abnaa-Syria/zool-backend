enum BrokerOfficeStatus {
  ACTIVE
  SUSPENDED
}

enum BrokerEmployeeRole {
  MANAGER
  CLERK
}

enum BrokerEmployeeStatus {
  ACTIVE
  SUSPENDED
}

enum SettlementPeriod {
  WEEKLY
  MONTHLY
}

enum BrokerOtpPurpose {
  BROKER_LOGIN
}

/// Broker branch / ticketing office.
model BrokerOffice {
  id                               String             @id @default(cuid())
  code                             String             @unique @db.VarChar(64)
  name                             String             @db.VarChar(160)
  status                           BrokerOfficeStatus @default(ACTIVE)
  minTopUpMinorOverride            Int?               @map("min_top_up_minor_override")
  exposureCeilingOverride          Int?               @map("exposure_ceiling_override")
  lowBalanceThresholdMinorOverride Int?               @map("low_balance_threshold_minor_override")
  timeZone                         String?            @map("time_zone") @db.VarChar(64)
  settlementPeriod                 SettlementPeriod   @map("settlement_period")
  lastSettledAt                    DateTime?          @map("last_settled_at")
  createdAt                        DateTime           @default(now()) @map("created_at")
  updatedAt                        DateTime           @updatedAt @map("updated_at")

  employees             BrokerEmployee[]
  wallet                Wallet?
  carrierAssignments    BrokerCarrierAssignment[]
  seatHolds             SeatHold[]
  bookings              Booking[]
  commissionAccruals    CommissionAccrual[]
  commissionPayouts     CommissionPayout[]
  commissionSettlements CommissionSettlement[]
  topUpIntents          TopUpIntent[]
  bookingGroups         BookingGroup[]

  @@index([status])
  @@map("broker_offices")
}

model BrokerEmployee {
  id             String               @id @default(cuid())
  officeId       String               @map("office_id")
  displayName    String               @map("display_name") @db.VarChar(160)
  role           BrokerEmployeeRole
  status         BrokerEmployeeStatus @default(ACTIVE)
  canBook        Boolean              @default(true) @map("can_book")
  canTopUp       Boolean              @default(false) @map("can_top_up")
  canViewReports Boolean              @default(false) @map("can_view_reports")
  canManageStaff Boolean              @default(false) @map("can_manage_staff")
  authzVersion   Int                  @default(1) @map("authz_version")
  lastLoginAt    DateTime?            @map("last_login_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  office                 BrokerOffice            @relation(fields: [officeId], references: [id], onDelete: Cascade)
  identities             BrokerIdentity[]
  refreshSessions        BrokerRefreshSession[]
  otpChallenges          BrokerOtpChallenge[]
  seatHolds              SeatHold[]
  bookings               Booking[]
  topUpIntentsCreated    TopUpIntent[]           @relation("TopUpCreatedBy")
  topUpEvidenceUploaded  TopUpEvidence[]         @relation("TopUpEvidenceEmployee")
  ticketDispatchAttempts TicketDispatchAttempt[]

  @@index([officeId, status])
  @@index([status])
  @@map("broker_employees")
}

/// Verified login identifier bound to a broker employee.
model BrokerIdentity {
  id               String       @id @default(cuid())
  brokerEmployeeId String       @map("broker_employee_id")
  type             IdentityType
  valueNormalized  String       @map("value_normalized") @db.VarChar(191)
  isPrimary        Boolean      @default(true) @map("is_primary")
  verifiedAt       DateTime?    @map("verified_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  brokerEmployee BrokerEmployee @relation(fields: [brokerEmployeeId], references: [id], onDelete: Cascade)

  @@unique([type, valueNormalized])
  @@index([brokerEmployeeId])
  @@map("broker_identities")
}

model BrokerRefreshSession {
  id               String    @id @default(cuid())
  brokerEmployeeId String    @map("broker_employee_id")
  /// SHA-256 hash of the opaque refresh token
  tokenHash        String    @unique @map("token_hash") @db.Char(64)
  /// Family id for rotation reuse detection
  familyId         String    @map("family_id") @db.VarChar(64)
  replacedById     String?   @map("replaced_by_id")
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  revokeReason     String?   @map("revoke_reason") @db.VarChar(120)
  createdAt        DateTime  @default(now()) @map("created_at")
  lastUsedAt       DateTime? @map("last_used_at")

  brokerEmployee BrokerEmployee @relation(fields: [brokerEmployeeId], references: [id], onDelete: Cascade)

  @@index([brokerEmployeeId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("broker_refresh_sessions")
}

model BrokerOtpChallenge {
  id               String             @id @default(cuid())
  brokerEmployeeId String             @map("broker_employee_id")
  identityType     IdentityType       @map("identity_type")
  identityValue    String             @map("identity_value") @db.VarChar(191)
  purpose          BrokerOtpPurpose
  /// HMAC of OTP code — never plaintext
  codeHash         String             @map("code_hash") @db.VarChar(128)
  status           OtpChallengeStatus @default(PENDING)
  attemptCount     Int                @default(0) @map("attempt_count")
  maxAttempts      Int                @map("max_attempts")
  expiresAt        DateTime           @map("expires_at")
  consumedAt       DateTime?          @map("consumed_at")
  requestId        String?            @map("request_id") @db.VarChar(64)
  createdAt        DateTime           @default(now()) @map("created_at")

  brokerEmployee BrokerEmployee @relation(fields: [brokerEmployeeId], references: [id], onDelete: Cascade)

  @@index([brokerEmployeeId, purpose, status])
  @@index([identityValue, purpose, status])
  @@index([expiresAt])
  @@map("broker_otp_challenges")
}
