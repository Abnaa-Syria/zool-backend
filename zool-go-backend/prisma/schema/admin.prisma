enum AdminStatus {
  ACTIVE
  SUSPENDED
}

enum IdentityType {
  PHONE
  EMAIL
}

/// Central platform administrator account.
model AdminUser {
  id             String      @id @default(cuid())
  employeeCode   String      @unique @map("employee_code") @db.VarChar(64)
  displayName    String      @map("display_name") @db.VarChar(160)
  status         AdminStatus @default(ACTIVE)
  isBootstrap    Boolean     @default(false) @map("is_bootstrap")
  authzVersion   Int         @default(1) @map("authz_version")
  lastLoginAt    DateTime?   @map("last_login_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  identities     AdminIdentity[]
  userRoles      UserRole[]
  refreshSessions RefreshSession[]
  otpChallenges  OtpChallenge[]
  auditLogs              AuditLog[]              @relation("AuditActor")
  commissionPayouts      CommissionPayout[]      @relation("CommissionPayoutActor")
  settlementsInitiated   CommissionSettlement[]  @relation("SettlementInitiator")
  settlementsFinalized   CommissionSettlement[]  @relation("SettlementFinalizer")
  topUpsCreated          TopUpIntent[]           @relation("TopUpCreatedByAdmin")
  topUpsReviewed         TopUpIntent[]           @relation("TopUpReviewedByAdmin")
  topUpEvidenceUploaded  TopUpEvidence[]         @relation("TopUpEvidenceAdmin")

  @@index([status])
  @@map("admin_users")
}

/// Verified login identifier bound to an admin (phone now; email later).
model AdminIdentity {
  id               String       @id @default(cuid())
  adminUserId      String       @map("admin_user_id")
  type             IdentityType
  /// Normalized identifier, e.g. E.164 phone +2499...
  valueNormalized  String       @map("value_normalized") @db.VarChar(191)
  isPrimary        Boolean      @default(true) @map("is_primary")
  verifiedAt       DateTime?    @map("verified_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  adminUser        AdminUser    @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@unique([type, valueNormalized])
  @@index([adminUserId])
  @@map("admin_identities")
}
