# Application
NODE_ENV=development
PORT=4000
APP_NAME=zool-go-backend
API_PREFIX=/api/v1

# MySQL (Prisma)
# Prefer a user that can CREATE databases (shadow DB) for migrate dev
DATABASE_URL=mysql://root:root@127.0.0.1:3308/zoolgo

# Redis
REDIS_URL=redis://127.0.0.1:6380
REDIS_KEY_PREFIX=zoolgo:

# JWT access tokens (short-lived)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_ACCESS_TTL_SECONDS=900

# Refresh tokens (opaque, HTTP-only cookie)
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_COOKIE_NAME=zoolgo_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_DOMAIN=
REFRESH_COOKIE_PATH=/api/v1/auth

# CORS / CSRF strategy: SameSite=Lax + explicit origin allowlist (no wildcard with credentials)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=false

# OTP
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_HMAC_SECRET=change-me-otp-hmac-secret-min-32-chars
OTP_DEV_EXPOSE=true
OTP_REQUEST_RATE_LIMIT_MAX=10
OTP_REQUEST_RATE_LIMIT_WINDOW_SECONDS=600
OTP_VERIFY_RATE_LIMIT_MAX=20
OTP_VERIFY_RATE_LIMIT_WINDOW_SECONDS=600

# Bootstrap Super Admin (development seed only — never use in production)
BOOTSTRAP_SUPER_ADMIN_PHONE=+249900000001
BOOTSTRAP_SUPER_ADMIN_DISPLAY_NAME=Super Admin
BOOTSTRAP_SUPER_ADMIN_EMPLOYEE_CODE=ZG-EMP-BOOTSTRAP

# Stage 2 — broker vertical
MIN_TOP_UP_AMOUNT=10000
DEFAULT_BOOKING_EXPOSURE_CEILING=100
DEFAULT_SETTLEMENT_PERIOD=MONTHLY
SEAT_HOLD_TTL_SECONDS=900
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change-me-payment-webhook-secret
PAYMENT_WEBHOOK_MAX_AGE_SECONDS=300
PLATFORM_TIMEZONE=Africa/Khartoum
UPLOAD_DIR=./uploads
BROKER_REFRESH_COOKIE_NAME=zoolgo_broker_refresh
BROKER_REFRESH_COOKIE_PATH=/api/v1/broker/auth
LOW_BALANCE_WARNING_THRESHOLD=20000

# Logging
LOG_LEVEL=info

# Dev/staging only: keep the demo carrier scheduled this many days ahead (0 = off). See docs/APP_DEVELOPER_GUIDE.md
DEMO_SCHEDULE_DAYS=14
